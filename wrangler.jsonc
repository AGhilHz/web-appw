{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-appw",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "1fdc23e0-8da1-4dc9-b11a-eb45c1662ea9","database_name": "web-appw" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "b54a7e58dedb42528810a179874d2270" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
